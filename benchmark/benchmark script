# --- 2. Optimizer Definitions & Standard Muon Newton-Schulz ---
def zeropower_via_newtonschulz5(G, steps=5):
    """
    Standard Newton-Schulz iteration of order 5 (Reference: Keller Jordan's Muon implementation).
    Operates in FP32 for numerical stability with safe clamping.
    Standard Muon Coefficients: X_next = X * (3.4375 * I - 4.75 * A + 2.0625 * A^2)
    """
    M, N = G.shape
    transpose = M > N
    original_dtype = G.dtype
    X = G.float()
    X = X.t() if transpose else X
    X = X / X.norm().clamp_min(1e-12)

    for _ in range(steps):
        A = X @ X.t()  # Shape: (M, M) or (N, N) depending on dimensions
        I = torch.eye(A.shape[0], device=X.device, dtype=X.dtype)
        poly = 3.4375 * I - 4.75 * A + 2.0625 * (A @ A)
        X = poly @ X

    return (X.t() if transpose else X).to(original_dtype)

class MuonStandalone(torch.optim.Optimizer):
    """
    Custom Standalone Hybrid Muon Optimizer (Reference: Keller Jordan's Muon design).
    Applies standard Muon update to 2D parameters and AdamW update to all non-2D / embeddings / head parameters.
    """
    def __init__(self, params, lr=1e-3, betas=(0.9, 0.95), eps=1e-8, weight_decay=1e-2):
        defaults = dict(lr=lr, betas=betas, eps=eps, weight_decay=weight_decay)
        super().__init__(params, defaults)

    @torch.no_grad()
    def step(self, closure=None):
        loss = None
        if closure is not None:
            with torch.enable_grad():
                loss = closure()
        for group in self.param_groups:
            is_muon_group = group.get('use_muon', False)
            beta1, beta2 = group['betas']
            for p in group['params']:
                if p.grad is None:
                    continue
                grad = p.grad
                state = self.state[p]
                if len(state) == 0:
                    state['step'] = 0
                    state['exp_avg'] = torch.zeros_like(p)
                    if not (is_muon_group and p.ndim == 2):
                        state['exp_avg_sq'] = torch.zeros_like(p)
                state['step'] += 1
                exp_avg = state['exp_avg']

                if group['weight_decay'] != 0:
                    p.mul_(1.0 - group['lr'] * group['weight_decay'])

                if is_muon_group and p.ndim == 2:
                    exp_avg.mul_(beta1).add_(grad, alpha=1.0 - beta1)
                    update = zeropower_via_newtonschulz5(exp_avg)
                    # Scale update by learning rate
                    p.add_(update, alpha=-group['lr'])
                else:
                    exp_avg_sq = state['exp_avg_sq']
                    exp_avg.mul_(beta1).add_(grad, alpha=1.0 - beta1)
                    exp_avg_sq.mul_(beta2).addcmul_(grad, grad, value=1.0 - beta2)
                    bias_correction1 = 1.0 - beta1 ** state['step']
                    bias_correction2 = 1.0 - beta2 ** state['step']
                    step_size = group['lr'] / bias_correction1
                    denom = (exp_avg_sq.sqrt() / np.sqrt(bias_correction2)).add_(group['eps'])
                    p.addcdiv_(exp_avg, denom, value=-step_size)
        return loss

class AdamWMuon(torch.optim.Optimizer):
    """
    A hybrid baseline optimizer applying standard AdamW to all layers but using Muon updates on 2D parameters.
    """
    def __init__(self, params, lr=1e-3, betas=(0.9, 0.999), eps=1e-8, weight_decay=1e-2):
        defaults = dict(lr=lr, betas=betas, eps=eps, weight_decay=weight_decay)
        super().__init__(params, defaults)

    @torch.no_grad()
    def step(self, closure=None):
        loss = None
        if closure is not None:
            with torch.enable_grad():
                loss = closure()
        for group in self.param_groups:
            is_muon_group = group.get('use_muon', False)
            for p in group['params']:
                if p.grad is None:
                    continue
                grad = p.grad
                state = self.state[p]
                if len(state) == 0:
                    state['step'] = 0
                    state['exp_avg'] = torch.zeros_like(p)
                    state['exp_avg_sq'] = torch.zeros_like(p)
                exp_avg, exp_avg_sq = state['exp_avg'], state['exp_avg_sq']
                beta1, beta2 = group['betas']
                state['step'] += 1

                if group['weight_decay'] != 0:
                    p.mul_(1.0 - group['lr'] * group['weight_decay'])

                if is_muon_group and p.ndim == 2:
                    exp_avg.mul_(beta1).add_(grad, alpha=1.0 - beta1)
                    update = zeropower_via_newtonschulz5(exp_avg)
                    p.add_(update, alpha=-group['lr'])
                else:
                    exp_avg.mul_(beta1).add_(grad, alpha=1 - beta1)
                    exp_avg_sq.mul_(beta2).addcmul_(grad, grad, value=1 - beta2)
                    bias_correction1 = 1 - beta1 ** state['step']
                    bias_correction2 = 1 - beta2 ** state['step']
                    step_size = group['lr'] / bias_correction1
                    denom = (exp_avg_sq.sqrt() / np.sqrt(bias_correction2)).add_(group['eps'])
                    p.addcdiv_(exp_avg, denom, value=-step_size)
        return loss

# --- 3. Model Architecture (NanoPoor Transformer ~150M Params) ---
class Block(nn.Module):
    def __init__(self, n_embd, n_head, block_size):
        super().__init__()
        head_size = n_embd // n_head
        self.sa = CausalSelfAttention(n_embd, n_head, head_size, block_size)
        self.ffwd = FeedFoward(n_embd)
        self.ln1 = nn.LayerNorm(n_embd)
        self.ln2 = nn.LayerNorm(n_embd)
    def forward(self, x):
        x = x + self.sa(self.ln1(x))
        x = x + self.ffwd(self.ln2(x))
        return x

class CausalSelfAttention(nn.Module):
    def __init__(self, n_embd, n_head, head_size, block_size):
        super().__init__()
        self.n_head = n_head
        self.head_size = head_size
        self.key = nn.Linear(n_embd, n_embd, bias=False)
        self.query = nn.Linear(n_embd, n_embd, bias=False)
        self.value = nn.Linear(n_embd, n_embd, bias=False)
        self.proj = nn.Linear(n_embd, n_embd, bias=False)
        self.register_buffer("bias", torch.tril(torch.ones(block_size, block_size)).view(1, 1, block_size, block_size))
    def forward(self, x):
        B, T, C = x.shape
        k = self.key(x).view(B, T, self.n_head, self.head_size).transpose(1, 2)
        q = self.query(x).view(B, T, self.n_head, self.head_size).transpose(1, 2)
        v = self.value(x).view(B, T, self.n_head, self.head_size).transpose(1, 2)
        att = (q @ k.transpose(-2, -1)) * (1.0 / np.sqrt(k.size(-1)))
        att = att.masked_fill(self.bias[:,:,:T,:T] == 0, float('-inf'))
        att = nn.functional.softmax(att, dim=-1)
        y = att @ v
        y = y.transpose(1, 2).contiguous().view(B, T, C)
        return self.proj(y)

class FeedFoward(nn.Module):
    def __init__(self, n_embd):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(n_embd, 4 * n_embd, bias=False),
            nn.GELU(),
            nn.Linear(4 * n_embd, n_embd, bias=False),
        )
    def forward(self, x):
        return self.net(x)

class NanoPoorTransformer(nn.Module):
    def __init__(self, vocab_size=50257, n_embd=768, n_head=12, n_layer=10, block_size=256):
        super().__init__()
        self.token_embedding_table = nn.Embedding(vocab_size, n_embd)
        self.position_embedding_table = nn.Embedding(block_size, n_embd)
        self.blocks = nn.Sequential(*[Block(n_embd, n_head, block_size) for _ in range(n_layer)])
        self.ln_f = nn.LayerNorm(n_embd)
        self.lm_head = nn.Linear(n_embd, vocab_size, bias=False)
        self.apply(self._init_weights)
    def _init_weights(self, module):
        if isinstance(module, nn.Linear):
            torch.nn.init.normal_(module.weight, mean=0.0, std=0.02)
            if module.bias is not None:
                torch.nn.init.zeros_(module.bias)
        elif isinstance(module, nn.Embedding):
            torch.nn.init.normal_(module.weight, mean=0.0, std=0.02)
    def forward(self, idx, targets=None):
        B, T = idx.shape
        tok_emb = self.token_embedding_table(idx)
        pos_emb = self.position_embedding_table(torch.arange(T, device=idx.device))
        x = tok_emb + pos_emb
        x = self.blocks(x)
        x = self.ln_f(x)
        logits = self.lm_head(x)
        loss = None
        if targets is not None:
            loss = nn.functional.cross_entropy(logits.view(-1, logits.size(-1)), targets.view(-1))
        return logits, loss

# Helper to dynamically split parameters based on modules
def get_grouped_parameters(model):
    muon_params = []
    standard_params = []
    for name, param in model.named_parameters():
        if "token_embedding_table" in name or "position_embedding_table" in name or "lm_head" in name:
            standard_params.append(param)
        elif param.ndim == 2:
            muon_params.append(param)
        else:
            standard_params.append(param)
    return [
        {"params": muon_params, "use_muon": True},
        {"params": standard_params, "use_muon": False}
    ]

# --- 4. Benchmarking Engine with Isolated Timing & LR Warmup ---
def run_real_benchmark(optimizer_name, num_steps=3000, lr_warmup_steps=30, timing_warmup_steps=40, batch_size=8, seq_len=256):
    device = 'cuda'
    torch.manual_seed(42)
    torch.cuda.manual_seed_all(42)
    torch.cuda.empty_cache()
    torch.cuda.reset_peak_memory_stats()

    model = NanoPoorTransformer(vocab_size=vocab_size).to(device)
    grouped_params = get_grouped_parameters(model)
    peak_lr = 1e-3

    # Map parameter group setup identically across custom hybrid and ApexW comparison suites
    if optimizer_name == "AdamW":
        optimizer = torch.optim.AdamW(model.parameters(), lr=peak_lr, weight_decay=1e-2)
    elif optimizer_name == "AdamW(fused)":
        optimizer = torch.optim.AdamW(model.parameters(), lr=peak_lr, weight_decay=1e-2, fused=True)
    elif optimizer_name == "ApexW":
        optimizer = ApexW(model.parameters(), lr=peak_lr, weight_decay=1e-2, precision='compact', use_muon=False)
    elif optimizer_name == "Muon":
        optimizer = MuonStandalone(grouped_params, lr=peak_lr, weight_decay=1e-2)
    elif optimizer_name == "AdamW(Muon)":
        optimizer = AdamWMuon(grouped_params, lr=peak_lr, weight_decay=1e-2)
    elif optimizer_name == "ApexW(Muon)":
        # Use identical parameter grouping to make comparisons equivalent
        optimizer = ApexW(grouped_params, lr=peak_lr, weight_decay=1e-2, precision='compact', use_muon=True)

    # Scheduler with 30 steps warmup
    def lr_lambda(current_step):
        if current_step < lr_warmup_steps:
            return float(current_step) / float(max(1, lr_warmup_steps))
        return 1.0
    scheduler = torch.optim.lr_scheduler.LambdaLR(optimizer, lr_lambda)

    scaler = torch.amp.GradScaler('cuda')
    times = []
    loss_history = []
    val_loss_history = []

    for step in range(num_steps):
        x, y = get_real_batch(train_data, batch_size=batch_size, seq_len=seq_len, device=device)
        optimizer.zero_grad(set_to_none=True)

        start_time = time.perf_counter()
        with torch.amp.autocast('cuda', dtype=torch.float16):
            _, loss = model(idx=x, targets=y)

        scaler.scale(loss).backward()
        scaler.unscale_(optimizer)
        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)

        scaler.step(optimizer)
        scaler.update()
        scheduler.step()

        torch.cuda.synchronize()
        step_time_ms = (time.perf_counter() - start_time) * 1000

        # Measure speed ONLY after LR Warmup is completed to isolate schedule effects
        if step >= timing_warmup_steps:
            times.append(step_time_ms)
        loss_history.append(loss.item())

        # Evaluate on validation dataset every 50 steps and at the final step
        if (step % 50 == 0) or (step == num_steps - 1):
            model.eval()
            with torch.no_grad():
                with torch.amp.autocast('cuda', dtype=torch.float16):
                    _, v_loss = model(idx=fixed_val_x, targets=fixed_val_y)
                val_loss_history.append((step, v_loss.item()))
            model.train()

    # Throughput metrics extraction
    mean_step = np.mean(times) if times else 0.0
    median_step = np.median(times) if times else 0.0
    tokens_per_step = batch_size * seq_len
    tokens_per_sec = (tokens_per_step / (median_step / 1000.0)) if median_step > 0 else 0.0

    # This measures the absolute peak allocated VRAM across the entire run (including any validation overhead)
    peak_mem_gb = torch.cuda.max_memory_allocated(device=device) / (1024 ** 3)

    # Log metadata metrics for report credibility
    total_params = sum(p.numel() for p in model.parameters())

    del model, optimizer, scaler, scheduler
    torch.cuda.empty_cache()

    return {
        'mean_step_time': mean_step,
        'median_step_time': median_step,
        'tokens_per_sec': tokens_per_sec,
        'peak_mem': peak_mem_gb,
        'loss_history': loss_history,
        'val_loss_history': val_loss_history,
        'total_params': total_params
    }

